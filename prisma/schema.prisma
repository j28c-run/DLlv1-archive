// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Photo {
  id          String   @id @default(cuid())
  src         String
  thumb       String?
  width       Int?
  height      Int?
  title       String?
  description String?
  date        DateTime?
  location    String?
  category    String?
  source      String   @default("local")
  sourceUrl   String?
  views       Int      @default(0)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags TagOnPhoto[]

  // Referencias inversas
  collectionCovers Collection[]      @relation("CollectionCover")
  inCollections    CollectionPhoto[]

  @@index([category])
  @@index([source])
  @@index([date])
  @@index([pinned, createdAt])
  @@index([createdAt])
}

model Tag {
  id     String        @id @default(cuid())
  name   String        @unique
  photos TagOnPhoto[]
}

model TagOnPhoto {
  photoId String
  tagId   String
  photo   Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
  @@index([tagId])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

// Tableros / colecciones estilo Pinterest
model Collection {
  id           String             @id @default(cuid())
  name         String
  description  String?
  coverPhotoId String?
  coverPhoto   Photo?             @relation("CollectionCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos       CollectionPhoto[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([createdAt])
}

model CollectionPhoto {
  collectionId String
  photoId      String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  photo        Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([collectionId, photoId])
  @@index([photoId])
}
